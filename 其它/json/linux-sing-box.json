{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {"disabled": false, "level": "info", "timestamp": true},
  "dns": {
    "servers": [
        {"type": "udp", "tag": "aliyun", "server": "223.5.5.5", "server_port": 53},
        {"type": "tls", "tag": "aliyun-DoT", "server": "dns.alidns.com", "server_port": 853, "domain_resolver": "aliyun"},
        {"type": "udp", "tag": "google", "server": "8.8.8.8", "server_port": 53, "detour": "hysteria2-out"},
        {"type": "tls", "tag": "google-DoT", "server": "dns.google", "server_port": 853, "domain_resolver": "google", "detour": "hysteria2-out"}
    ],
    "rules": [
        {"rule_set": "geosite-cn", "action": "route", "server": "aliyun-DoT"},
        {"domain": ["example.domain.com"], "action": "route", "server": "aliyun-DoT"}
    ],
    "final": "google-DoT",
    "strategy": "prefer_ipv4"
  },
  "ntp": {"enabled": true, "server": "ntp.aliyun.com", "server_port": 123, "interval": "30s"},
  "inbounds": [
    {
        "type": "tun",
        "tag": "tun-in",
        "interface_name": "tun-sbx",
        "address": ["172.18.0.1/30"],
        "mtu": 1500,
        "dns_mode": "hijack",
        "auto_route": true,
        "strict_route": true,
        "platform": {
            "http_proxy": {"enabled": false, "server": "127.0.0.1", "server_port": 8088}
        }
    }
  ],
  "outbounds": [
    {"type": "direct", "tag": "direct-out"},
    {
        "type": "hysteria2",
        "tag": "hysteria2-out",
        "server": "<your.domain.com>",
        "server_port": 20000,
        "server_ports": ["20001:30001", "30002:49990"],
        "hop_interval": "30s",
        "hop_interval_max": "60s",
        "up_mbps": 1024,
        "down_mbps": 1024,
        "password": "user:password",
        "tls": {
            "enabled": true, "disable_sni": false, "server_name": "<your.domain.com>", "insecure": false
        }
    }
  ],
  "http_clients": [
    {"tag": "proxy_client", "detour": "hysteria2-out"},
    {"tag": "direct_client", "detour": "direct-out"}
  ],
  "route": {
    "rule_set": [
        {
            "type": "remote",
            "tag": "geoip-cn",
            "format": "binary",
            "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs",
            "http_client": "proxy_client",
            "update_interval": "24h"
        },
        {
            "type": "remote",
            "tag": "geosite-cn",
            "format": "binary",
            "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-cn.srs",
            "http_client": "proxy_client",
            "update_interval": "24h"
        }
    ],
    "rules": [
        {"action": "sniff", "timeout": "3s"},
        {"protocol": "dns", "action": "hijack-dns"},
        {"rule_set": ["geoip-cn", "geosite-cn"], "action": "route", "outbound": "direct-out"},
        {"ip_is_private": true, "action": "route", "outbound": "direct-out"}
    ],
    "final": "hysteria2-out",
    "auto_detect_interface": true,
    "find_process": true,
    "find_neighbor": true,
    "default_domain_resolver": "aliyun-DoT"
  },
  "experimental": {
    "cache_file": {
        "enabled": true, 
        "path": "/home/90017289/workspace/app/sing-box-1.14.1/cache_file.db", 
        "store_dns": true
    },
    "clash_api": {
        "external_controller": "127.0.0.1:9090",
        "external_ui": "/home/90017289/workspace/app/sing-box-1.14.1/ui",
        "external_ui_download_url": "https://github.com/MetaCubeX/Yacd-meta/archive/gh-pages.zip",
        "external_ui_download_detour": "hysteria2-out",
        "access_control_allow_private_network": true
    }
  }
}