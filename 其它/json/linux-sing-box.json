{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {"disabled": false, "level": "warn", "timestamp": true},
  "dns": {
    "servers": [
        {"type": "udp", "tag": "aliyun", "server": "223.5.5.5", "server_port": 53},
        {"type": "tls", "tag": "aliyun-tls", "server": "dns.alidns.com", "server_port": 853, "domain_resolver": "aliyun"},
        {"type": "udp", "tag": "google", "server": "8.8.8.8", "server_port": 53, "detour": "hysteria2-out"},
        {"type": "tls", "tag": "google-tls", "server": "dns.google", "server_port": 853, "domain_resolver": "google", "detour": "hysteria2-out"}
    ],
    "rules": [
        {"rule_set": "geosite-cn", "action": "route", "server": "aliyun-tls"},
        {"domain": "ocisg.156753.xyz", "action": "route", "server": "aliyun-tls"}
    ],
    "final": "google-tls",
    "strategy": "prefer_ipv4",
    "cache_capacity": 1024,
    "optimistic": {"enabled": true, "timeout": "24h"},
    "timeout": "5s"
  },
  "ntp": {"enabled": true, "server": "ntp.ntsc.ac.cn", "server_port": 123, "interval": "20m"},
  "http_clients": [{"tag": "proxy_client", "detour": "hysteria2-out"}, {"tag": "direct_client", "detour": "direct-out"}],
  "inbounds": [
    {
        "type": "tun", 
        "tag": "tun-in", 
        "interface_name": "if-sbx", 
        "address": "172.18.0.1/30", 
        "mtu": 1500, 
        "dns_mode": "hijack", 
        "auto_route": true, 
        "strict_route": true, 
        "platform": 
        {
            "http_proxy": 
            {
                "enabled": true, 
                "server": "127.0.0.1", 
                "server_port": 10800
            }
        }
    }    
  ],
  "outbounds": [
    {"type": "direct", "tag": "direct-out"},
    {
        "type": "hysteria2",
        "tag": "hysteria2-out",
        "server": "ocisg.156753.xyz",
        "server_port": 20000,
        "server_ports": ["20001:30000", "30001:49000"],
        "hop_interval": "25s",
        "hop_interval_max": "50s",
        "up_mbps": 1024,
        "down_mbps": 1024,
        "password": "username:password",
        "tls": {"enabled": true, "disable_sni": false, "server_name": "ocisg.156753.xyz", "insecure": false}
    }
  ],
  "route": {
    "rule_set": [
        {"type": "remote", "tag": "geoip-cn", "format": "binary", "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs", "http_client": "proxy_client", "update_interval": "24h"},
        {"type": "remote", "tag": "geosite-cn", "format": "binary", "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-cn.srs", "http_client": "proxy_client", "update_interval": "24h"}
    ],
    "rules": [
        {"action": "sniff", "timeout": "5s"},
        {"protocol": "dns", "action": "hijack-dns"},
        {"rule_set": ["geoip-cn", "geosite-cn"], "action": "route", "outbound": "direct-out"},
        {"ip_is_private": true, "action": "route", "outbound": "direct-out"}
    ],
    "final": "hysteria2-out",
    "auto_detect_interface": true,
    "find_process": true,
    "find_neighbor": true,
    "default_http_client": "direct_client",
    "default_domain_resolver": "aliyun-tls"
  },
  "experimental": {
    "cache_file": {"enabled": true, "path": "/home/90017289/workspace/app/sing-box-1.14.1/cache_file.db", "store_dns": true},
    "clash_api": {
        "external_controller": "127.0.0.1:9090", 
        "external_ui": "/home/90017289/workspace/app/sing-box-1.14.1/ui",
        "external_ui_download_url": "https://github.com/MetaCubeX/Yacd-meta/archive/gh-pages.zip",
        "external_ui_download_detour": "hysteria2-out"
    }
  }
}